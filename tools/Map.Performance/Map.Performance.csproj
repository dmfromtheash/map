<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Map.App\Map.App.csproj" />
    <ProjectReference Include="..\..\src\Map.Core\Map.Core.csproj" />
    <ProjectReference Include="..\..\src\Map.Presentation\Map.Presentation.csproj" />
    <ProjectReference Include="..\..\src\Map.Rendering\Map.Rendering.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Methods with loops (every per-pixel brush, coverage and sampling loop) are compiled
         optimized at their first call instead of running tier-0 code until re-jitted: the first
         stroke of a session used to queue 200-300 ms of input behind unoptimized loops. -->
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

</Project>
