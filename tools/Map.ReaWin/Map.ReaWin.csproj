<Project Sdk="Microsoft.NET.Sdk">

  <!-- REA's native UI capture for Windows (the upstream helper ReaNativeUI.swift is macOS only):
       observe-native-ui and capture-native-ui-scenario with REA's request/result shape, through
       Windows UI Automation (FlaUI, DEC-050) and PrintWindow, plus a layout audit of the captured
       tree. REA is MIT (github.com/morluto/rea); the contract is followed, no code is copied.
       Not part of Map.slnx and never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Map.ReaWin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

</Project>
