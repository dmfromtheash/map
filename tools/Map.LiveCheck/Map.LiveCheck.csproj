<Project Sdk="Microsoft.NET.Sdk">

  <!-- Black-box live pass over the real Map.App.exe through Windows UI Automation (FlaUI, DEC-050):
       starts the program in an isolated test profile, waits for the library window, dumps the
       UIA tree, screenshots it, opens the New Map wizard, screenshots it and closes everything.
       Not part of Map.slnx and never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- FlaUI needs the Accessibility assembly of the Windows Desktop runtime. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Map.LiveCheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

</Project>
