+using Map.Core.Documents;
+using Map.Rendering.Pyramid;
+using SkiaSharp;
+
+namespace Map.Rendering.Tests;
+
+public sealed class PyramidContinuityTests
+{
+    [Theory]
+    [InlineData(1d / 64)]
+    [InlineData(1d / 32)]
+    [InlineData(1d / 16)]
+    public void Synthetic_live_scene_matches_assembled_pyramid_at_enter_threshold(double scale)
+    {
+        var extent = 1.5 / scale;
+        var random = new Random(114);
+        string[] colors = ["#FFFF2010", "#8000FF40", "#B02040FF", "#FF101010", "#60FFFF00"];
+        double[] sizes = [.125, .125, .125, .125, 4.5]; // Mean = extent; includes exact and dot paths.
+        var objects = Enumerable.Range(0, 500).Select(i =>
+            new SceneObject(ObjectId.New(), i % 2 == 0 ? SceneObjectKind.Rectangle : SceneObjectKind.Ellipse,
+                "synthetic", random.Next(16000), random.Next(16000), extent * sizes[i % 5],
+                extent * sizes[i % 5], i % 3 == 0 ? 17 : 0, colors[i % 5], "#00000000", 0, true, false)
+            { ObjectOpacity = .7 }).ToArray();
+        var document = new MapDocument(DocumentId.New(), "synthetic continuity", DateTimeOffset.UnixEpoch,
+            new CanvasDefinition(32768, 32768, "px", "#00000000"),
+            [new BaseColorLayer(LayerId.New(), "paper", true, false, .6, "#80406080"),
+             new ObjectLayer(LayerId.New(), "synthetic", true, false, .8, objects)]);
+        var geometry = new PyramidGeometry(32768, 32768, 256);
+        var policy = new PyramidViewPolicy(geometry, new() { Enabled = true });
+        var metrics = new PyramidSceneMetrics(objects.Length, objects.Average(o => Math.Max(o.Width, o.Height)));
+        Assert.Equal(scale, policy.Thresholds(metrics).EnterScale, 12);
+        var selected = policy.Select(scale, metrics, default);
+        Assert.NotNull(selected.Level);
+        var level = selected.Level.Value;
+        Assert.Equal(scale, geometry.GetLevel(level).Scale);
+        var settings = new PyramidRenderSettings { DisableStyle = true, DisableLighting = true };
+        using var assembled = SKSurface.Create(new SKImageInfo(512, 512, SKColorType.Rgba8888, SKAlphaType.Premul))!;
+        assembled.Canvas.Clear(SKColors.Transparent);
+        var rasterizer = new PyramidTileRasterizer();
+        for (var y = 0; y < 2; y++)
+        for (var x = 0; x < 2; x++)
+        {
+            using var tile = rasterizer.Rasterize(document, geometry, new(level, x, y), settings);
+            Assert.Equal(PyramidRasterStatus.Success, tile.Status);
+            assembled.Canvas.DrawImage(tile.Image!, x * 256, y * 256);
+        }
+        using var actual = assembled.Snapshot();
+        using var live = PyramidFixtures.Live(document, settings, new(0, 0, 512 / scale, 512 / scale), scale, 512, 512);
+        using var a = ReadPremultiplied(actual);
+        using var b = ReadPremultiplied(live);
+        var ap = a.GetPixelSpan();
+        var bp = b.GetPixelSpan();
+        var sums = new long[4];
+        var maxima = new int[4];
+        for (var i = 0; i < ap.Length; i++)
+        {
+            var delta = Math.Abs(ap[i] - bp[i]);
+            sums[i % 4] += delta;
+            maxima[i % 4] = Math.Max(maxima[i % 4], delta);
+        }
+        var means = sums.Select(sum => sum / (512d * 512)).ToArray();
+        Console.WriteLine($"PYRAMID_COLOUR scale={scale:R} level={level} RGBA max=[{string.Join(",", maxima)}]/255 mean=[{string.Join(",", means.Select(m => m.ToString("F8", System.Globalization.CultureInfo.InvariantCulture)))}]/255");
+        var tolerance = new PyramidColourTuning();
+        Assert.True(PyramidContinuity.IsCompatible(
+            new(maxima[0] / 255d, maxima[1] / 255d, maxima[2] / 255d, maxima[3] / 255d),
+            new(means[0] / 255, means[1] / 255, means[2] / 255, means[3] / 255), tolerance));
+    }
+
+    [Theory]
+    [InlineData(.025)]
+    [InlineData(.0390625)]
+    [InlineData(.045)]
+    public void Non_dyadic_threshold_resampling_preserves_synthetic_colour_ramps(double scale)
+    {
+        // Plain premultiplied arrays isolate the colour/filter contract from SceneRenderer LOD.
+        var geometry = new PyramidGeometry(8192, 8192, 256);
+        var policy = new PyramidViewPolicy(geometry, new() { Enabled = true });
+        var metrics = new PyramidSceneMetrics(100, 1.5 / scale);
+        var selected = policy.Select(scale, metrics, default);
+        var levelScale = geometry.GetLevel(selected.Level!.Value).Scale;
+        const int side = 64;
+        var pyramid = new PyramidPremultipliedColor[side * side];
+        for (var y = 0; y < side; y++)
+        for (var x = 0; x < side; x++)
+            pyramid[y * side + x] = Ramp((x + .5) / levelScale, (y + .5) / levelScale);
+        var maximum = 0d;
+        var sum = 0d;
+        var samples = 0;
+        for (var y = 2; y < 30; y++)
+        for (var x = 2; x < 30; x++)
+        {
+            var live = Ramp((x + .5) / scale, (y + .5) / scale);
+            var px = (x + .5) / scale * levelScale - .5;
+            var py = (y + .5) / scale * levelScale - .5;
+            var ix = (int)Math.Floor(px); var iy = (int)Math.Floor(py);
+            var upper = PyramidContinuity.Blend(pyramid[iy * side + ix], pyramid[iy * side + ix + 1], px - ix);
+            var lower = PyramidContinuity.Blend(pyramid[(iy + 1) * side + ix], pyramid[(iy + 1) * side + ix + 1], px - ix);
+            var resampled = PyramidContinuity.Blend(upper, lower, py - iy);
+            for (var elapsed = 0; elapsed <= 8; elapsed++)
+            {
+                var blended = PyramidContinuity.Blend(live, resampled, PyramidContinuity.Weight(elapsed, 8));
+                double[] differences = [Math.Abs(blended.R - live.R), Math.Abs(blended.G - live.G),
+                    Math.Abs(blended.B - live.B), Math.Abs(blended.A - live.A)];
+                maximum = Math.Max(maximum, differences.Max());
+                sum += differences.Sum(); samples += 4;
+            }
+        }
+        Console.WriteLine($"PYRAMID_RAMP scale={scale:R} max={maximum:R} mean={sum / samples:R} (normalized premultiplied RGBA)");
+        Assert.InRange(maximum, 0, 1e-12);
+        Assert.InRange(sum / samples, 0, 1e-13);
+    }
+
+    [Fact]
+    public void Scale_dependent_overview_dots_must_pass_colour_admission_before_takeover()
+    {
+        const double scale = .02;
+        const int side = 160;
+        var objects = Enumerable.Range(0, 1600).Select(i => new SceneObject(ObjectId.New(),
+            SceneObjectKind.Ellipse, "dot", (i % 40) * 180 + 75, (i / 40) * 180 + 75,
+            75, 75, 0, "#FF102030", "#00000000", 0, true, false)).ToArray();
+        var document = new MapDocument(DocumentId.New(), "LOD admission", DateTimeOffset.UnixEpoch,
+            new CanvasDefinition(16384, 16384, "px", "#FFFFFFFF"),
+            [new BaseColorLayer(LayerId.New(), "paper", true, false, 1, "#FFFFFFFF"),
+             new ObjectLayer(LayerId.New(), "dots", true, false, 1, objects)]);
+        var geometry = new PyramidGeometry(16384, 16384, 256);
+        var policy = new PyramidViewPolicy(geometry, new() { Enabled = true });
+        var target = policy.Select(scale, new(objects.Length, 75), default);
+        var level = geometry.GetLevel(target.Level!.Value);
+        var settings = new PyramidRenderSettings { DisableStyle = true, DisableLighting = true };
+        using var tile = new PyramidTileRasterizer().Rasterize(document, geometry, new(level.Index, 0, 0), settings);
+        Assert.Equal(PyramidRasterStatus.Success, tile.Status);
+        using var resampled = SKSurface.Create(new SKImageInfo(side, side, SKColorType.Rgba8888, SKAlphaType.Premul))!;
+        resampled.Canvas.Clear(SKColors.Transparent);
+        resampled.Canvas.DrawImage(tile.Image!, SKRect.Create((float)(256 * scale / level.Scale),
+            (float)(256 * scale / level.Scale)), new SKSamplingOptions(SKFilterMode.Linear, SKMipmapMode.None));
+        using var image = resampled.Snapshot();
+        using var live = PyramidFixtures.Live(document, settings, new(0, 0, side / scale, side / scale), scale, side, side);
+        using var a = ReadPremultiplied(image);
+        using var b = ReadPremultiplied(live);
+        var ap = a.GetPixelSpan(); var bp = b.GetPixelSpan();
+        var sums = new long[4]; var maxima = new double[4];
+        for (var i = 0; i < ap.Length; i++)
+        {
+            var difference = Math.Abs(ap[i] - bp[i]);
+            sums[i % 4] += difference; maxima[i % 4] = Math.Max(maxima[i % 4], difference / 255d);
+        }
+        var means = sums.Select(sum => sum / (255d * side * side)).ToArray();
+        var compatible = PyramidContinuity.IsCompatible(new(maxima[0], maxima[1], maxima[2], maxima[3]),
+            new(means[0], means[1], means[2], means[3]), new());
+        Console.WriteLine($"PYRAMID_LOD_ADMISSION scale={scale:R} max={maxima.Max() * 255:R}/255 meanMax={means.Max() * 255:R}/255 compatible={compatible}");
+        Assert.False(compatible); // Cross-fading alone cannot correct a different endpoint picture.
+        Assert.Equal(PyramidViewSource.Live, policy.Advance(default, target, 0, compatible).Target);
+    }
+
+    [Fact]
+    public void Transparent_edges_and_encoded_midtones_do_not_gain_brightness_or_lose_alpha()
+    {
+        var red = new PyramidPremultipliedColor(.5, 0, 0, .5);
+        var transparent = default(PyramidPremultipliedColor);
+        Assert.Equal(new PyramidPremultipliedColor(.25, 0, 0, .25), PyramidContinuity.Blend(red, transparent, .5));
+        var grey = new PyramidPremultipliedColor(.25, .25, .25, .5);
+        for (var i = 0; i <= 8; i++)
+        {
+            var result = PyramidContinuity.Blend(grey, grey, PyramidContinuity.Weight(i, 8));
+            Assert.Equal(grey, result); // No gamma round-trip and no double SrcOver attenuation.
+        }
+        Assert.Equal(red, PyramidContinuity.Blend(red, transparent, 0));
+        Assert.Equal(transparent, PyramidContinuity.Blend(red, transparent, 1));
+    }
+
+    [Fact]
+    public void Colour_admission_rejects_mean_drift_single_channel_outliers_and_invalid_measurements()
+    {
+        var tuning = new PyramidColourTuning();
+        Assert.True(PyramidContinuity.IsCompatible(new(8d / 255, 0, 0, 0), new(.05 / 255, 0, 0, 0), tuning));
+        Assert.False(PyramidContinuity.IsCompatible(new(9d / 255, 0, 0, 0), default, tuning));
+        Assert.False(PyramidContinuity.IsCompatible(default, new(0, .051 / 255, 0, 0), tuning));
+        Assert.False(PyramidContinuity.IsCompatible(default, new(0, 0, 0, .051 / 255), tuning));
+        Assert.False(PyramidContinuity.IsCompatible(new(double.NaN, 0, 0, 0), default, tuning));
+        Assert.False(PyramidContinuity.IsCompatible(default, new(0, 0, -1, 0), tuning));
+        Assert.Throws<ArgumentOutOfRangeException>(() => PyramidContinuity.IsCompatible(default, default,
+            new() { MeanChannelDifference = 1 }));
+    }
+
+    [Fact]
+    public void Fade_reference_handles_zero_duration_and_rejects_invalid_inputs()
+    {
+        Assert.Equal(1, PyramidContinuity.Weight(0, 0));
+        Assert.Equal(1, PyramidContinuity.Weight(long.MaxValue, 8));
+        Assert.Equal(.25, PyramidContinuity.Weight(0, 8, .25));
+        Assert.Throws<ArgumentOutOfRangeException>(() => PyramidContinuity.Weight(-1, 8));
+        Assert.Throws<ArgumentOutOfRangeException>(() => PyramidContinuity.Weight(1, -1));
+        foreach (var weight in new[] { -.1, 1.1, double.NaN, double.PositiveInfinity })
+        {
+            Assert.Throws<ArgumentOutOfRangeException>(() => PyramidContinuity.Weight(0, 8, weight));
+            Assert.Throws<ArgumentOutOfRangeException>(() => PyramidContinuity.Blend(default, default, weight));
+        }
+    }
+
+    private static PyramidPremultipliedColor Ramp(double x, double y) =>
+        new(.1 + x / 16384, .05 + y / 16384, .1 + (x + y) / 32768, .4 + x / 32768 + y / 65536);
+
+    private static SKBitmap ReadPremultiplied(SKImage image)
+    {
+        var bitmap = new SKBitmap(new SKImageInfo(image.Width, image.Height, SKColorType.Rgba8888, SKAlphaType.Premul));
+        Assert.True(image.ReadPixels(bitmap.Info, bitmap.GetPixels(), bitmap.RowBytes));
+        return bitmap;
+    }
+}
diff --git a/tests/Map.Rendering.Tests/PyramidViewPolicyTests.cs b/tests/Map.Rendering.Tests/PyramidViewPolicyTests.cs
new file mode 100644
index 0000000..e5a052c
--- /dev/null
+++ b/tests/Map.Rendering.Tests/PyramidViewPolicyTests.cs
@@ -0,0 +1,266 @@
+using Map.Rendering.Pyramid;
+
+namespace Map.Rendering.Tests;
+
+public sealed class PyramidViewPolicyTests
+{
+    private static readonly PyramidGeometry Geometry = new(131072, 131072);
+    private static readonly PyramidSceneMetrics Metrics = new(2_000_000);
+    private static PyramidViewPolicy Policy(PyramidViewTuning? tuning = null) =>
+        new(Geometry, tuning ?? new() { Enabled = true });
+
+    [Fact]
+    public void Density_threshold_matches_core_and_explicit_size_overrides_spacing()
+    {
+        var policy = Policy();
+        var thresholds = policy.Thresholds(Metrics);
+        Assert.Equal(Geometry.TakeoverScale(Metrics.ObjectCount), thresholds.EnterScale, 12);
+        Assert.Equal(1.5, thresholds.ObjectExtentWorld * thresholds.EnterScale, 12);
+        Assert.Equal(2, thresholds.ObjectExtentWorld * thresholds.ExitScale, 12);
+        Assert.True(thresholds.UsesDensityEstimate);
+        var actualSize = policy.Thresholds(new(1, 100));
+        Assert.Equal(.015, actualSize.EnterScale);
+        Assert.Equal(.02, actualSize.ExitScale);
+        Assert.False(actualSize.UsesDensityEstimate);
+        Console.WriteLine($"PYRAMID_THRESHOLD count={Metrics.ObjectCount} extent={thresholds.ObjectExtentWorld:R} enter={thresholds.EnterScale:R} exit={thresholds.ExitScale:R}");
+    }
+
+    [Fact]
+    public void Default_is_live_and_empty_or_single_tile_maps_stay_live()
+    {
+        Assert.Equal(PyramidViewSource.Live, new PyramidViewPolicy(Geometry).Select(.001, Metrics, default));
+        Assert.Equal(PyramidViewSource.Live, Policy().Select(.001, new(0), default));
+        Assert.Equal(PyramidViewSource.Live, new PyramidViewPolicy(new(512, 512), new() { Enabled = true })
+            .Select(.001, Metrics, default));
+        Assert.Equal(1, Policy().Thresholds(new(long.MaxValue)).ExitScale);
+        var disabled = new PyramidViewPolicy(Geometry).Advance(default, PyramidViewSource.Pyramid(0), 0, true);
+        Assert.Equal(PyramidViewSource.Live, disabled.Target);
+        Assert.Equal(1, disabled.TargetWeight);
+    }
+
+    [Fact]
+    public void Level_sweeps_are_monotonic_in_both_directions_and_obey_upscale_cap()
+    {
+        var policy = Policy();
+        foreach (var increasing in new[] { true, false })
+        {
+            int? previous = null;
+            for (var step = 0; step <= 2048; step++)
+            {
+                var t = (increasing ? step : 2048 - step) / 2048d;
+                var scale = Math.Pow(2, -12 + 12 * t) * 1.25;
+                var level = policy.SelectLevel(scale, previous);
+                Assert.NotNull(level);
+                Assert.True(scale / Geometry.GetLevel(level.Value).Scale <= 1.25);
+                if (previous is { } old) Assert.True(increasing ? level >= old : level <= old);
+                previous = level;
+            }
+        }
+        Assert.Null(policy.SelectLevel(1.250001));
+        Assert.Equal(Geometry.Levels.Count - 1, policy.SelectLevel(1.25));
+        Assert.Equal(0, policy.SelectLevel(double.Epsilon));
+    }
+
+    [Theory]
+    [InlineData(1)]
+    [InlineData(1.25)]
+    [InlineData(2)]
+    public void Stateless_level_is_closest_multiplicatively_among_eligible_levels(double cap)
+    {
+        var policy = Policy(new() { Enabled = true, MaximumUpscale = cap });
+        for (var i = 0; i < 400; i++)
+        {
+            var scale = Math.Pow(2, -11 + i / 40d);
+            var selected = policy.SelectLevel(scale)!.Value;
+            var distance = Math.Abs(Math.Log2(Geometry.GetLevel(selected).Scale / scale));
+            foreach (var candidate in Geometry.Levels.Where(l => scale / l.Scale <= cap))
+                Assert.True(distance <= Math.Abs(Math.Log2(candidate.Scale / scale)) + 1e-12);
+        }
+    }
+
+    [Fact]
+    public void Recorded_wheel_noise_crosses_each_mode_threshold_only_once()
+    {
+        var policy = Policy();
+        var thresholds = policy.Thresholds(Metrics);
+        // Recorded relative wheel positions, including sub-step input noise and direction changes.
+        double[] wheel = [1.06, 1.025, .995, 1.013, .982, 1.021, .998, 1.009, .975, 1.018, .99, 1.003];
+        var scales = new List<double> { thresholds.ExitScale * 1.1 };
+        for (var repeat = 0; repeat < 8; repeat++) scales.AddRange(wheel.Select(x => thresholds.EnterScale * x));
+        scales.Add(thresholds.ExitScale * 1.04);
+        for (var repeat = 0; repeat < 8; repeat++) scales.AddRange(wheel.Select(x => thresholds.ExitScale * x));
+        var replay = Replay(policy, scales);
+        var modes = replay.Select(f => f.Target.Level is not null).ToArray();
+        Assert.Equal(2, modes.Zip(modes.Skip(1)).Count(p => p.First != p.Second));
+        Assert.Equal(replay, Replay(policy, scales));
+        Console.WriteLine($"PYRAMID_REPLAY frames={scales.Count} modeChanges=2 deterministic=true");
+    }
+
+    [Fact]
+    public void Adjacent_level_noise_does_not_oscillate_even_with_capped_boundary()
+    {
+        foreach (var cap in new[] { 1d, 1.25, 2 })
+        {
+            var policy = Policy(new() { Enabled = true, MaximumUpscale = cap });
+            const int coarse = 2;
+            var boundary = Geometry.GetLevel(coarse).Scale * Math.Min(Math.Sqrt(2), cap);
+            int? previous = coarse;
+            var changes = 0;
+            double[] wheel = [.98, 1.02, .995, 1.01, .99, 1.03, 1.001, .97];
+            for (var step = 0; step < 160; step++)
+            {
+                var next = policy.SelectLevel(boundary * wheel[step % wheel.Length], previous);
+                if (next != previous) changes++;
+                previous = next;
+            }
+            Assert.InRange(changes, 0, 1);
+            Assert.Equal(coarse + 1, policy.SelectLevel(boundary * 1.11, coarse));
+            Assert.Equal(coarse, policy.SelectLevel(boundary / 1.11, coarse + 1));
+        }
+    }
+
+    [Fact]
+    public void Dwell_blocks_rapid_mode_reversal_then_permits_it_at_exact_boundary()
+    {
+        var policy = Policy(new() { Enabled = true, FadeFrames = 0 });
+        var start = policy.Advance(default, PyramidViewSource.Pyramid(1), 10, true);
+        var held = policy.Advance(start.State, PyramidViewSource.Live, 21, true);
+        Assert.Equal(start.Target, held.Target);
+        var exit = policy.Advance(held.State, PyramidViewSource.Live, 22, true);
+        Assert.Equal(PyramidViewSource.Live, exit.Target);
+        Assert.Equal(1, exit.TargetWeight);
+    }
+
+    [Fact]
+    public void Incomplete_or_colour_incompatible_target_cannot_start_a_fade()
+    {
+        var policy = Policy();
+        var desired = PyramidViewSource.Pyramid(1);
+        var missing = policy.Advance(default, desired, 100, false);
+        Assert.Equal(PyramidViewSource.Live, missing.Target);
+        Assert.False(missing.NeedsAnotherFrame);
+        var ready = policy.Advance(missing.State, desired, 101, true);
+        Assert.Equal(0, ready.TargetWeight);
+        Assert.Equal(1, ready.FromWeight);
+        Assert.True(ready.NeedsAnotherFrame);
+        // Already participating sources are retained by the host, independently of new readiness.
+        var done = policy.Advance(ready.State, desired, 109, false);
+        Assert.Equal(1, done.TargetWeight);
+        Assert.Equal(desired, done.From);
+        Assert.False(done.NeedsAnotherFrame);
+    }
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public void Fade_weights_are_monotonic_and_finish_exactly_at_one(bool levelChange)
+    {
+        var policy = Policy(new() { Enabled = true, MinimumDwellFrames = 0 });
+        var state = levelChange ? policy.Advance(default, PyramidViewSource.Pyramid(0), 0, true).State : default;
+        var desired = PyramidViewSource.Pyramid(1);
+        if (levelChange) state = policy.Advance(state, state.Target, 8, true).State;
+        var previous = 0d;
+        for (var elapsed = 0; elapsed <= 9; elapsed++)
+        {
+            var frame = policy.Advance(state, desired, 20 + elapsed, true);
+            Assert.InRange(frame.TargetWeight, previous, 1);
+            Assert.Equal(1, frame.FromWeight + frame.TargetWeight);
+            if (elapsed == 0) Assert.Equal(0, frame.TargetWeight);
+            if (elapsed >= 8) Assert.Equal(1, frame.TargetWeight);
+            previous = frame.TargetWeight;
+            state = frame.State;
+        }
+    }
+
+    [Fact]
+    public void Reversing_a_partial_fade_preserves_the_exact_premultiplied_picture()
+    {
+        var policy = Policy(new() { Enabled = true, MinimumDwellFrames = 0, FadeFrames = 20 });
+        var target = PyramidViewSource.Pyramid(1);
+        var start = policy.Advance(default, target, 0, true);
+        var forward = policy.Advance(start.State, target, 5, true);
+        var reverse = policy.Advance(forward.State, PyramidViewSource.Live, 5, true);
+        Assert.Equal(.25, forward.TargetWeight);
+        Assert.Equal(.75, reverse.TargetWeight);
+        Assert.Equal(forward.From, reverse.Target);
+        Assert.Equal(forward.Target, reverse.From);
+        var live = new PyramidPremultipliedColor(.1, .2, .3, .5);
+        var pyramid = new PyramidPremultipliedColor(.7, .3, .1, .8);
+        Assert.Equal(PyramidContinuity.Blend(live, pyramid, forward.TargetWeight),
+            PyramidContinuity.Blend(pyramid, live, reverse.TargetWeight));
+        Assert.Equal(1, policy.Advance(reverse.State, reverse.Target, 25, true).TargetWeight);
+    }
+
+    [Fact]
+    public void A_third_source_waits_for_current_fade_without_dropping_an_endpoint()
+    {
+        var policy = Policy(new() { Enabled = true, MinimumDwellFrames = 0 });
+        var first = PyramidViewSource.Pyramid(0);
+        var second = PyramidViewSource.Pyramid(2);
+        var start = policy.Advance(default, first, 0, true);
+        var pending = policy.Advance(start.State, second, 4, true);
+        Assert.Equal(first, pending.Target);
+        Assert.Equal(.5, pending.TargetWeight);
+        var next = policy.Advance(pending.State, second, 8, true);
+        Assert.Equal(first, next.From);
+        Assert.Equal(second, next.Target);
+        Assert.Equal(0, next.TargetWeight);
+    }
+
+    [Fact]
+    public void Extreme_jump_repeated_frame_and_skipped_frames_are_deterministic()
+    {
+        var policy = Policy();
+        double[] scales = [.1, .00001, .00001, .2, .005, .005, .5];
+        Assert.Equal(Replay(policy, scales), Replay(policy, scales));
+        var start = policy.Advance(default, PyramidViewSource.Pyramid(0), long.MaxValue - 20, true);
+        Assert.Equal(start, policy.Advance(start.State, start.Target, long.MaxValue - 20, true));
+        Assert.Equal(1, policy.Advance(start.State, start.Target, long.MaxValue, true).TargetWeight);
+        Assert.Throws<ArgumentOutOfRangeException>(() => policy.Advance(start.State, start.Target, 0, true));
+        Assert.Throws<ArgumentOutOfRangeException>(() => policy.Advance(default, start.Target, -1, true));
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(-1)]
+    [InlineData(double.NaN)]
+    [InlineData(double.PositiveInfinity)]
+    public void Invalid_scales_are_rejected(double scale)
+    {
+        Assert.Throws<ArgumentOutOfRangeException>(() => Policy().Select(scale, Metrics, default));
+        Assert.Throws<ArgumentOutOfRangeException>(() => Policy().SelectLevel(scale));
+    }
+
+    [Fact]
+    public void Invalid_statistics_sources_and_tuning_are_rejected()
+    {
+        var policy = Policy();
+        foreach (var metrics in new PyramidSceneMetrics[] { new(-1), new(1, 0), new(1, -1), new(1, double.NaN), new(1, double.PositiveInfinity) })
+            Assert.Throws<ArgumentOutOfRangeException>(() => policy.Thresholds(metrics));
+        PyramidViewTuning[] invalid =
+        [
+            new() { EnterObjectPixels = 0 }, new() { EnterObjectPixels = double.NaN },
+            new() { ExitObjectPixels = 1.5 }, new() { ExitObjectPixels = double.PositiveInfinity },
+            new() { MaximumPyramidScale = -1 }, new() { MaximumUpscale = .9 },
+            new() { LevelHysteresisRatio = .9 }, new() { MinimumDwellFrames = -1 }, new() { FadeFrames = -1 },
+        ];
+        foreach (var tuning in invalid) Assert.Throws<ArgumentOutOfRangeException>(() => Policy(tuning));
+        Assert.Throws<ArgumentOutOfRangeException>(() => policy.SelectLevel(.01, -1));
+        Assert.Throws<ArgumentOutOfRangeException>(() => policy.Advance(default, PyramidViewSource.Pyramid(100), 0, true));
+    }
+
+    private static PyramidViewFrame[] Replay(PyramidViewPolicy policy, IEnumerable<double> scales)
+    {
+        var frames = new List<PyramidViewFrame>();
+        var state = default(PyramidViewState);
+        long frameNumber = 0;
+        foreach (var scale in scales)
+        {
+            var desired = policy.Select(scale, Metrics, state);
+            var next = policy.Advance(state, desired, frameNumber++, true);
+            frames.Add(next);
+            state = next.State;
+        }
+        return frames.ToArray();
+    }
+}
