@@ -0,0 +1,118 @@
+# DEC-114: чистая политика live overview ↔ pyramid
+
+Статус: **FACT** — отдельные чистые функции и тесты; **PARTIAL** — цветовая
+непрерывность проверена на синтетике; **NOT CHECKED** — Windows, GPU, реальный canvas/FPS.
+Вызовов из действующего рендера нет. `PyramidViewTuning.Enabled` по умолчанию false.
+Документ, Undo, формат сохранения, UI, диск и потоки не меняются.
+
+## Порог и уровень
+
+Вход `PyramidSceneMetrics`: количество видимых объектов и, если доступно, среднее
+`max(width,height)` в мировых единицах. Статистику поддерживает владелец документа
+по дельтам; политика не обходит объекты. Без среднего размера используется прежний
+proxy ядра `e = sqrt(canvasWidth * canvasHeight / objectCount)` — средний шаг,
+а не размер силуэтов. Он неточен для редких крупных объектов и кластеров.
+
+`enterScale = min(MaximumPyramidScale, EnterObjectPixels / e)`;
+`exitScale = min(MaximumPyramidScale, ExitObjectPixels / e)`.
+Из live вход при `scale <= enterScale`, из pyramid выход при `scale > exitScale`.
+Пустая карта и карта из одного тайла остаются live. Scale включает DPI:
+число физических пикселей экрана на мировую единицу.
+
+| Настройка | Default | Основание |
+|---|---:|---|
+| Enabled | false | Отдельный seam до подключения и проверки canvas |
+| EnterObjectPixels / ExitObjectPixels | 1.5 / 2 | DEC-114 и запас 33 % против wheel-noise |
+| MaximumPyramidScale | 1 | В ядре нет разрешения выше native |
+| MaximumUpscale | 1.25 | Ограниченное увеличение, более мелкий уровень при превышении |
+| LevelHysteresisRatio | 1.1 | Разнесение границ соседних уровней |
+| MinimumDwellFrames | 12 | Минимум между началами переходов (200 мс только при 60 FPS) |
+| FadeFrames | 8 | Короткий переход (133 мс только при 60 FPS) |
+| MaximumChannelDifference | 8/255 | Допуск редких CPU-отклонений на стыках, НЕ побитовая идентичность |
+| MeanChannelDifference | 0.05/255 | Строгое ограничение среднего сдвига каждого RGBA-канала |
+
+Последние две настройки находятся в `PyramidColourTuning`, остальные — в
+`PyramidViewTuning`. Числа не являются результатом продуктовой визуальной приёмки.
+Для строгого режима можно задать нулевые допуски цвета.
+
+Без истории выбирается допустимый уровень с минимальным
+`abs(log2(level.Scale) - log2(viewScale))`; при равенстве — более подробный.
+`viewScale / level.Scale <= MaximumUpscale`. Если даже native не подходит,
+`SelectLevel` возвращает null. Индексы растут с приближением.
+Для соседних уровней `c < f` базовая граница
+`b = min(sqrt(c*f), c*MaximumUpscale)`.
+Уход с грубого вверх при `scale >= min(b*H, c*MaximumUpscale)`,
+обратно при `scale <= b/H`. Ограничение upscale не переворачивает полосу гистерезиса.
+Sweep в обоих направлениях и шум у границ проверены тестами.
+
+## Источники кадра и готовность
+
+Последовательность вызовов будущего canvas:
+
+1. Хранить `PyramidViewState` отдельно для одного document/geometry/tuning lifetime.
+   Начальное значение — default (live). При смене документа/геометрии/настроек сбросить.
+2. `desired = policy.Select(scale, metrics, previousState)`.
+3. Проверить **весь видимый прямоугольник** desired: есть готовые пиксели,
+   одинаковые постоянные render settings и согласованная ревизия. Старая готовая
+   ревизия может оставаться при пересборке согласно DEC-114. Нельзя принимать смесь
+   настроек или независимых ревизий соседних тайлов за готовую картинку.
+4. При подготовке проверить цветовую совместимость этой композиции с готовым live
+   в том же viewport/scale. `PyramidContinuity.IsCompatible` принимает четыре
+   максимума и четыре средних абсолютных разницы нормализованных premultiplied
+   RGBA. Все должны укладываться в tuning. Невалидные измерения не проходят.
+   Сравнение пикселей — работа подготовки, НЕ каждого кадра. Эта функция не создаёт
+   и не хранит доказательство совместимости: его lifetime/invalidation ведёт host.
+5. `frame = policy.Advance(previousState, desired, frameNumber, targetUsable)`;
+   `targetUsable = coverageReady && colourCompatible`. Live всегда доступен.
+   Неготовая/несовместимая цель оставляет текущее изображение. При активном fade
+   host обязан удержать оба участвующих источника, включая покрытие нового viewport.
+6. Рисовать From с положительным FromWeight и Target с положительным TargetWeight;
+   веса дают **взвешенную сумму целых premultiplied-картинок**, включая alpha.
+   После суммы наложить результат SrcOver один раз. Два SrcOver с дополнительными
+   opacity неэквивалентны: они меняют alpha и яркость полупрозрачных областей.
+7. Сохранить frame.State; при NeedsAnotherFrame запросить следующий кадр.
+
+Линейный вес `w = start + (1-start)*clamp(elapsed/FadeFrames,0,1)`;
+конец ровно 1, FadeFrames=0 даёт немедленный переход. Номера кадров неубывающие,
+повтор номера допустим, пропуск кадров корректен. При развороте A→B в B→A текущий
+вес заменяется на `1-w`, сохраняя картинку. Третья цель ждёт завершения текущей пары.
+Mode/level hysteresis выбирает цель; dwell ограничивает начала переходов, а fade
+удерживает старые источники до завершения. Ограничение upscale относится к **новой
+выбранной цели**, не к исходящему изображению при резком изменении камеры.
+
+## Реальный live-путь и цветовой контракт
+
+`MapCanvasControl` выбирает Overview при scale < 0.125 (Performance < 0.25).
+`SceneRenderer.DrawObjects` может сначала выбрать dense detail tiles от 0.03,
+иначе `DrawOverviewObjects` рисует чанки 8192 world units с bucket
+`floor(log2(scale)*4)`. Объекты >=4 px при bucketScale остаются точными,
+остальные — цветные точки или painted stamps. Подготовка может держать предыдущий
+готовый bucket; палитра и точные ассеты имеют собственную готовность.
+Включать policy в Exact/Interactive/другой live-путь без повторной проверки нельзя.
+
+`PyramidTileRasterizer` вызывает тот же `SceneRenderer` отдельно для **каждого**
+уровня, CPU RGBA8888/Premul, без color-space conversion, затем готовые изображения
+семплируются линейно без mip. Для перехода нужен тот же цветовой pipeline,
+encoded-space фильтр и premultiplied alpha. Нельзя только пирамиду переводить
+в linear light, менять gamma или строить родителя box-уменьшением другого LOD:
+это меняет плотность/цвет экранных точек. Скрытые sublayers, стили, свет и прочие
+постоянные настройки должны совпадать; editor overlays накладываются после перехода.
+
+Важно: равенство pipeline само по себе **не гарантирует** равенство endpoints
+при произвольном scale. Синтетический отрицательный тест при 0.02 показывает
+max 239/255, максимальное среднее канала 25.2766796875/255 между live и растянутым
+уровнем. Admission отвергает такую цель и оставляет live. Cross-fade не исправляет
+другую конечную картинку. Для широкого включения нужны совместимые по масштабу
+представления либо отдельное решение по LOD/визуальной приёмке. Известная зависимость
+Watercolor от viewport из отчёта rasterizer также остаётся.
+
+Синтетическая композиция четырёх CPU-тайлов на dyadic enter thresholds:
+1/64 max RGBA [0,0,0,0], 1/32 [1,1,1,1], 1/16 [7,7,1,5] (все /255).
+Средние каждого канала <=0.000145/255. Строгий пробный допуск 2/255 на 1/16
+не прошёл; renderer не исправлялся. Тест использует явные допускаемые 8/255 и
+0.05/255, а не заявляет pixel-identical. Off-grid массивы цветовых ramp с alpha
+при 0.025/0.0390625/0.045 проходят с max <=1.12e-16 (нормализованные компоненты).
+
+Никакого обхода всех объектов в Select/Advance нет: работа зависит только от
+числа уровней. Замеры аллокаций и времени кадров здесь не проводились;
+любое утверждение zero-allocation надо перепроверить на Windows.
diff --git a/src/Map.Rendering/Pyramid/PyramidContinuity.cs b/src/Map.Rendering/Pyramid/PyramidContinuity.cs
new file mode 100644
index 0000000..6b291db
--- /dev/null
+++ b/src/Map.Rendering/Pyramid/PyramidContinuity.cs
@@ -0,0 +1,63 @@
+namespace Map.Rendering.Pyramid;
+
+/// <summary>Stored, encoded RGBA components with premultiplied RGB; no gamma conversion.</summary>
+public readonly record struct PyramidPremultipliedColor(double R, double G, double B, double A);
+
+/// <summary>Normalized encoded component differences, evaluated during preparation, not per frame.</summary>
+public sealed record PyramidColourTuning
+{
+    public double MaximumChannelDifference { get; init; } = 8d / 255;
+    public double MeanChannelDifference { get; init; } = .05 / 255;
+}
+
+public static class PyramidContinuity
+{
+    /// <summary>
+    /// All four channel maxima AND means must pass. This is an admission contract, not a promise
+    /// that arbitrary style/LOD/viewport combinations are compatible. The host computes the
+    /// differences against the ready live picture in the same viewport and colour pipeline.
+    /// </summary>
+    public static bool IsCompatible(PyramidPremultipliedColor channelMaxima,
+        PyramidPremultipliedColor channelMeans, PyramidColourTuning tuning)
+    {
+        ArgumentNullException.ThrowIfNull(tuning);
+        if (!Valid(tuning.MaximumChannelDifference) || !Valid(tuning.MeanChannelDifference)
+            || tuning.MaximumChannelDifference > 1 || tuning.MeanChannelDifference > tuning.MaximumChannelDifference)
+            throw new ArgumentOutOfRangeException(nameof(tuning));
+        return Within(channelMaxima, tuning.MaximumChannelDifference) && Within(channelMeans, tuning.MeanChannelDifference);
+    }
+
+    /// <summary>Linear fade, including exact endpoints; zero duration is an immediate cut.</summary>
+    public static double Weight(long elapsedFrames, int durationFrames, double startWeight = 0)
+    {
+        ArgumentOutOfRangeException.ThrowIfNegative(elapsedFrames);
+        ArgumentOutOfRangeException.ThrowIfNegative(durationFrames);
+        if (!double.IsFinite(startWeight) || startWeight < 0 || startWeight > 1)
+            throw new ArgumentOutOfRangeException(nameof(startWeight));
+        if (durationFrames == 0 || elapsedFrames >= durationFrames) return 1;
+        return startWeight + (1 - startWeight) * (elapsedFrames / (double)durationFrames);
+    }
+
+    /// <summary>
+    /// Reference arithmetic for the canvas seam, including alpha. Never blend straight RGB or
+    /// apply two SrcOver opacities. Blend in the same encoded component space as live overview;
+    /// changing only the pyramid to linear-light downsampling would change its brightness.
+    /// </summary>
+    public static PyramidPremultipliedColor Blend(PyramidPremultipliedColor from,
+        PyramidPremultipliedColor target, double targetWeight)
+    {
+        if (!double.IsFinite(targetWeight) || targetWeight < 0 || targetWeight > 1)
+            throw new ArgumentOutOfRangeException(nameof(targetWeight));
+        if (targetWeight == 0) return from;
+        if (targetWeight == 1) return target;
+        var a = 1 - targetWeight;
+        return new(a * from.R + targetWeight * target.R, a * from.G + targetWeight * target.G,
+            a * from.B + targetWeight * target.B, a * from.A + targetWeight * target.A);
+    }
+
+    private static bool Within(PyramidPremultipliedColor value, double limit) =>
+        Valid(value.R) && value.R <= limit && Valid(value.G) && value.G <= limit
+        && Valid(value.B) && value.B <= limit && Valid(value.A) && value.A <= limit;
+
+    private static bool Valid(double value) => double.IsFinite(value) && value >= 0;
+}
diff --git a/src/Map.Rendering/Pyramid/PyramidViewPolicy.cs b/src/Map.Rendering/Pyramid/PyramidViewPolicy.cs
new file mode 100644
index 0000000..53260b9
--- /dev/null
+++ b/src/Map.Rendering/Pyramid/PyramidViewPolicy.cs
@@ -0,0 +1,204 @@
+namespace Map.Rendering.Pyramid;
+
+/// <summary>
+/// Snapshot statistics supplied by the document owner, never collected by the frame policy.
+/// MeanObjectExtentWorld is the mean max(width,height) of visible objects, when available.
+/// Otherwise canvas-wide mean spacing is used as an explicitly approximate density proxy.
+/// Maintain statistics from edit deltas; do not enumerate the document for each frame.
+/// </summary>
+public readonly record struct PyramidSceneMetrics(long ObjectCount, double? MeanObjectExtentWorld = null);
+
+public sealed record PyramidViewTuning
+{
+    // Opt in only after the host can supply ready, colour-compatible pictures.
+    public bool Enabled { get; init; }
+    public double EnterObjectPixels { get; init; } = 1.5;
+    public double ExitObjectPixels { get; init; } = 2;
+    public double MaximumPyramidScale { get; init; } = 1;
+    public double MaximumUpscale { get; init; } = 1.25;
+    public double LevelHysteresisRatio { get; init; } = 1.1;
+    public int MinimumDwellFrames { get; init; } = 12;
+    public int FadeFrames { get; init; } = 8;
+}
+
+public readonly record struct PyramidSwitchThresholds(double EnterScale, double ExitScale,
+    double ObjectExtentWorld, bool UsesDensityEstimate);
+
+/// <summary>Default is live overview. A pyramid source denotes a complete visible level.</summary>
+public readonly record struct PyramidViewSource
+{
+    private readonly int _levelPlusOne;
+    private PyramidViewSource(int levelPlusOne) => _levelPlusOne = levelPlusOne;
+    public static PyramidViewSource Live => default;
+    public int? Level => _levelPlusOne == 0 ? null : _levelPlusOne - 1;
+    public static PyramidViewSource Pyramid(int level)
+    {
+        if (level < 0 || level == int.MaxValue) throw new ArgumentOutOfRangeException(nameof(level));
+        return new(level + 1);
+    }
+}
+
+/// <summary>Immutable replay state; default starts live. Reset for another document/geometry/tuning.</summary>
+public readonly record struct PyramidViewState
+{
+    public PyramidViewSource From { get; internal init; }
+    public PyramidViewSource Target { get; internal init; }
+    internal long StartFrame { get; init; }
+    internal double StartWeight { get; init; }
+    internal long LastChangeFrame { get; init; }
+    internal long LastFrame { get; init; }
+    internal bool HasChanged { get; init; }
+}
+
+/// <summary>
+/// Minimal canvas seam. Draw only positive-weight sources, in the same current viewport.
+/// Combine their complete premultiplied pictures by weighted addition, then SrcOver once.
+/// Two ordinary SrcOver draws with complementary opacity are NOT this operation.
+/// Retain both sources until the fade ends; NeedsAnotherFrame requests continued animation.
+/// </summary>
+public readonly record struct PyramidViewFrame(PyramidViewState State, double TargetWeight)
+{
+    public PyramidViewSource From => State.From;
+    public PyramidViewSource Target => State.Target;
+    public double FromWeight => 1 - TargetWeight;
+    public bool NeedsAnotherFrame => From != Target && TargetWeight < 1;
+}
+
+/// <summary>
+/// Pure DEC-114 mode/level policy. No document traversal, clocks, threads, rendering or storage.
+/// Level indices increase with resolution. Scale is device pixels per world unit (include DPI).
+/// </summary>
+public sealed class PyramidViewPolicy
+{
+    private readonly PyramidGeometry _geometry;
+    private readonly PyramidViewTuning _tuning;
+
+    public PyramidViewPolicy(PyramidGeometry geometry, PyramidViewTuning? tuning = null)
+    {
+        ArgumentNullException.ThrowIfNull(geometry);
+        _geometry = geometry;
+        _tuning = tuning ?? new();
+        Positive(_tuning.EnterObjectPixels, nameof(tuning));
+        Positive(_tuning.ExitObjectPixels, nameof(tuning));
+        Positive(_tuning.MaximumPyramidScale, nameof(tuning));
+        Positive(_tuning.MaximumUpscale, nameof(tuning));
+        Positive(_tuning.LevelHysteresisRatio, nameof(tuning));
+        if (_tuning.ExitObjectPixels <= _tuning.EnterObjectPixels
+            || _tuning.MaximumUpscale < 1 || _tuning.LevelHysteresisRatio < 1
+            || _tuning.MinimumDwellFrames < 0 || _tuning.FadeFrames < 0)
+            throw new ArgumentOutOfRangeException(nameof(tuning));
+    }
+
+    public PyramidSwitchThresholds Thresholds(PyramidSceneMetrics metrics)
+    {
+        ArgumentOutOfRangeException.ThrowIfNegative(metrics.ObjectCount);
+        if (metrics.MeanObjectExtentWorld is { } mean) Positive(mean, nameof(metrics));
+        if (metrics.ObjectCount == 0 || !_geometry.NeedsPyramid) return default;
+        var extent = metrics.MeanObjectExtentWorld
+            ?? Math.Sqrt((double)_geometry.Width * _geometry.Height / metrics.ObjectCount);
+        return new(Math.Min(_tuning.MaximumPyramidScale, _tuning.EnterObjectPixels / extent),
+            Math.Min(_tuning.MaximumPyramidScale, _tuning.ExitObjectPixels / extent),
+            extent, metrics.MeanObjectExtentWorld is null);
+    }
+
+    /// <summary>
+    /// First select the desired source, then ask the host whether that source is usable for Advance.
+    /// The previous target supplies hysteresis even during a fade. Empty/single-tile maps stay live.
+    /// </summary>
+    public PyramidViewSource Select(double viewScale, PyramidSceneMetrics metrics, PyramidViewState previous)
+    {
+        Positive(viewScale, nameof(viewScale));
+        ValidateSource(previous.Target);
+        var thresholds = Thresholds(metrics);
+        if (!_tuning.Enabled || thresholds.EnterScale == 0) return PyramidViewSource.Live;
+        var threshold = previous.Target.Level is null ? thresholds.EnterScale : thresholds.ExitScale;
+        if (viewScale > threshold) return PyramidViewSource.Live;
+        return SelectLevel(viewScale, previous.Target.Level) is { } level
+            ? PyramidViewSource.Pyramid(level) : PyramidViewSource.Live;
+    }
+
+    /// <summary>
+    /// Closest multiplicative texel/screen-pixel ratio to 1 among levels that obey MaximumUpscale.
+    /// Ties prefer finer resolution. Null means even the finest level would exceed that cap.
+    /// Hysteresis bands are based on the capped boundary, so the cap cannot invert the band.
+    /// </summary>
+    public int? SelectLevel(double viewScale, int? previousLevel = null)
+    {
+        Positive(viewScale, nameof(viewScale));
+        if (previousLevel is { } old) _geometry.GetLevel(old);
+        int? best = null;
+        var bestDistance = double.PositiveInfinity;
+        foreach (var level in _geometry.Levels)
+        {
+            if (viewScale / level.Scale > _tuning.MaximumUpscale) continue;
+            var distance = Math.Abs(Math.Log2(level.Scale) - Math.Log2(viewScale));
+            if (distance <= bestDistance) { best = level.Index; bestDistance = distance; }
+        }
+        if (best is null || previousLevel is not { } previous || best == previous) return best;
+        var current = _geometry.GetLevel(previous);
+        if (viewScale / current.Scale > _tuning.MaximumUpscale) return best;
+        if (best > previous)
+        {
+            var boundary = Boundary(current.Scale, _geometry.GetLevel(previous + 1).Scale);
+            var leave = Math.Min(boundary * _tuning.LevelHysteresisRatio, current.Scale * _tuning.MaximumUpscale);
+            if (viewScale < leave) return previous;
+        }
+        else
+        {
+            var boundary = Boundary(_geometry.GetLevel(previous - 1).Scale, current.Scale);
+            if (viewScale > boundary / _tuning.LevelHysteresisRatio) return previous;
+        }
+        return best;
+    }
+
+    /// <summary>
+    /// Frame numbers must be nonnegative and nondecreasing; no wall clock is read.
+    /// targetUsable certifies full viewport coverage, ready pixels and the continuity contract
+    /// in pyramid-view-policy.md, not just the existence of one tile. Live is always usable.
+    /// A missing target leaves the current picture in place. A third source waits for completion;
+    /// reversal swaps the two endpoints without changing their current weights.
+    /// </summary>
+    public PyramidViewFrame Advance(PyramidViewState previous, PyramidViewSource desired,
+        long frameNumber, bool targetUsable)
+    {
+        if (frameNumber < previous.LastFrame) throw new ArgumentOutOfRangeException(nameof(frameNumber));
+        ValidateSource(previous.From);
+        ValidateSource(previous.Target);
+        ValidateSource(desired);
+        var state = previous with { LastFrame = frameNumber };
+        if (!_tuning.Enabled)
+            return new(new PyramidViewState { LastFrame = frameNumber }, 1);
+        var weight = state.From == state.Target ? 1
+            : PyramidContinuity.Weight(frameNumber - state.StartFrame, _tuning.FadeFrames, state.StartWeight);
+        if (weight == 1) state = state with { From = state.Target };
+        var dwellElapsed = !state.HasChanged || frameNumber - state.LastChangeFrame >= _tuning.MinimumDwellFrames;
+        if (desired != state.Target && (desired.Level is null || targetUsable) && dwellElapsed)
+        {
+            if (state.From == state.Target || desired == state.From)
+            {
+                var start = state.From == state.Target ? 0 : 1 - weight;
+                state = state with
+                {
+                    From = state.Target, Target = desired, StartFrame = frameNumber, StartWeight = start,
+                    LastChangeFrame = frameNumber, HasChanged = true,
+                };
+                weight = PyramidContinuity.Weight(0, _tuning.FadeFrames, start);
+                if (weight == 1) state = state with { From = desired };
+            }
+        }
+        return new(state, weight);
+    }
+
+    private double Boundary(double coarse, double fine) =>
+        Math.Min(Math.Sqrt(coarse * fine), coarse * _tuning.MaximumUpscale);
+
+    private void ValidateSource(PyramidViewSource source)
+    {
+        if (source.Level is { } level) _geometry.GetLevel(level);
+    }
+
+    private static void Positive(double value, string name)
+    {
+        if (!double.IsFinite(value) || value <= 0) throw new ArgumentOutOfRangeException(name);
+    }
+}
