<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Map.App.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <!-- Map owns this neutral cartography palette; it is not copied from any third-party UI. -->
        <SolidColorBrush x:Key="MapSurface0Brush" Color="#0E1013" />
        <SolidColorBrush x:Key="MapSurface1Brush" Color="#14171C" />
        <SolidColorBrush x:Key="MapSurface2Brush" Color="#1A1E24" />
        <SolidColorBrush x:Key="MapSurface3Brush" Color="#222832" />
        <SolidColorBrush x:Key="MapSurfaceHoverBrush" Color="#2A313C" />
        <SolidColorBrush x:Key="MapBorderBrush" Color="#303744" />
        <SolidColorBrush x:Key="MapTextBrush" Color="#F3F5F7" />
        <SolidColorBrush x:Key="MapMutedTextBrush" Color="#9CA6B4" />
        <SolidColorBrush x:Key="MapAccentBrush" Color="#D2A85E" />
        <SolidColorBrush x:Key="MapAccentHoverBrush" Color="#E2BB73" />
        <SolidColorBrush x:Key="MapAccentMutedBrush" Color="#3A3123" />
        <SolidColorBrush x:Key="MapDangerBrush" Color="#D66B70" />
        <SolidColorBrush x:Key="MapFocusBrush" Color="#8EC5FF" />
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource MapSurface0Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource MapTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="UserControl">
            <Setter Property="Background" Value="{DynamicResource MapSurface0Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource MapTextBrush}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource MapMutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MapTextBrush}" />
        </Style>

        <Style Selector="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="13,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource MapSurface3Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource MapTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource MapSurfaceHoverBrush}" />
            <Setter Property="BorderBrush" Value="#46505F" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#303846" />
        </Style>
        <Style Selector="Button:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource MapFocusBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.48" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource MapAccentBrush}" />
            <Setter Property="Foreground" Value="#17130C" />
            <Setter Property="BorderBrush" Value="{DynamicResource MapAccentBrush}" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource MapAccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MapAccentHoverBrush}" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MapMutedTextBrush}" />
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource MapSurface3Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource MapTextBrush}" />
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MapMutedTextBrush}" />
        </Style>
        <Style Selector="Button.tool:pointerover">
            <Setter Property="Background" Value="{DynamicResource MapSurface3Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource MapTextBrush}" />
        </Style>
        <Style Selector="Button.tool.active">
            <Setter Property="Background" Value="{DynamicResource MapAccentMutedBrush}" />
            <Setter Property="BorderBrush" Value="#725D37" />
            <Setter Property="Foreground" Value="{DynamicResource MapAccentHoverBrush}" />
        </Style>
        <Style Selector="Button.list-item">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.list-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource MapSurface3Brush}" />
        </Style>
        <Style Selector="Button.list-item.selected">
            <Setter Property="Background" Value="{DynamicResource MapAccentMutedBrush}" />
            <Setter Property="BorderBrush" Value="#725D37" />
            <Setter Property="Foreground" Value="{DynamicResource MapAccentHoverBrush}" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="#F2B3B6" />
        </Style>
        <Style Selector="Button.map-card">
            <Setter Property="Width" Value="238" />
            <Setter Property="MinHeight" Value="190" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource MapSurface2Brush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.map-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource MapSurface3Brush}" />
            <Setter Property="BorderBrush" Value="#5B4B30" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="#111419" />
            <Setter Property="Foreground" Value="{DynamicResource MapTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MapBorderBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource MapAccentMutedBrush}" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource MapFocusBrush}" />
        </Style>

        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource MapMutedTextBrush}" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource MapTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Border.top-bar">
            <Setter Property="Background" Value="{DynamicResource MapSurface1Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MapBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.tool-strip">
            <Setter Property="Background" Value="{DynamicResource MapSurface1Brush}" />
            <Setter Property="BorderBrush" Value="#252B34" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.side-panel">
            <Setter Property="Background" Value="{DynamicResource MapSurface1Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>
        <Style Selector="Border.status-bar">
            <Setter Property="Background" Value="#111419" />
            <Setter Property="BorderBrush" Value="{DynamicResource MapBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style Selector="Border.hero-card">
            <Setter Property="Background" Value="{DynamicResource MapSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="Border.recovery-card">
            <Setter Property="Background" Value="#302A1F" />
            <Setter Property="BorderBrush" Value="#665333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="Separator">
            <Setter Property="Background" Value="{DynamicResource MapBorderBrush}" />
        </Style>
    </Application.Styles>
</Application>
