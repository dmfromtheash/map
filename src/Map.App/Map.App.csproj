<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Methods with loops (every per-pixel brush, coverage and sampling loop) are compiled
         optimized at their first call instead of running tier-0 code until re-jitted: the first
         stroke of a session used to queue 200-300 ms of input behind unoptimized loops. -->
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
    <TieredPGO>false</TieredPGO>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon-Large.ico</ApplicationIcon>
    <AvaloniaIncludeApplicationIconAsWindowIcon>true</AvaloniaIncludeApplicationIconAsWindowIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Atlas\*.png" />
    <AvaloniaResource Include="Assets\Fonts\Onest\*.ttf" />
    <AvaloniaResource Include="Assets\Fonts\Onest\OFL.txt" />
    <AvaloniaResource Include="Assets\Fonts\Cormorant\*.ttf" />
    <AvaloniaResource Include="Assets\Fonts\Cormorant\OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Map.Core\Map.Core.csproj" />
    <ProjectReference Include="..\Map.Export\Map.Export.csproj" />
    <ProjectReference Include="..\Map.Persistence\Map.Persistence.csproj" />
    <ProjectReference Include="..\Map.Rendering\Map.Rendering.csproj" />
    <ProjectReference Include="..\Map.Presentation\Map.Presentation.csproj" />
    <ProjectReference Include="..\Map.Platform.Windows\Map.Platform.Windows.csproj" />
    <ProjectReference Include="..\Map.Assets\Map.Assets.csproj" />
  </ItemGroup>
</Project>
