<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Map.Spike.App.MainWindow"
        Width="1400" Height="900"
        MinWidth="900" MinHeight="600"
        Title="Map technical spike"
        Background="#14161A">

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Background="#1D2027" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="18">
                <TextBlock Text="Map technical spike" Foreground="#E6E9EF" FontWeight="SemiBold" />
                <TextBlock x:Name="ModeText" Foreground="#9AA4B2" />
                <TextBlock x:Name="SceneText" Foreground="#9AA4B2" />
                <TextBlock x:Name="DirtyText" Foreground="#9AA4B2" />
            </StackPanel>
        </Border>

        <ContentControl Grid.Row="1" x:Name="CanvasHost" />

        <Border Grid.Row="2" Background="#1D2027" Padding="12,8">
            <StackPanel Spacing="3">
                <TextBlock x:Name="StatusText" Foreground="#D8DEE9" TextWrapping="Wrap" />
                <TextBlock x:Name="FailureText" Foreground="#FF6B6B" TextWrapping="Wrap" IsVisible="False" />
                <TextBlock x:Name="RendererText" Foreground="#8FD694" TextWrapping="Wrap" />
                <TextBlock x:Name="FrameText" Foreground="#9AA4B2" TextWrapping="Wrap" />
                <TextBlock x:Name="BenchmarkText" Foreground="#F2C94C" TextWrapping="Wrap" />
                <TextBlock x:Name="HitTestText" Foreground="#9AA4B2" TextWrapping="Wrap" />
                <TextBlock x:Name="MemoryText" Foreground="#9AA4B2" TextWrapping="Wrap" />
                <TextBlock x:Name="HelpText" Foreground="#6C7480" TextWrapping="Wrap"
                           Text="1 select · 2 brush · 3 mask erase · wheel zoom at cursor · middle-drag or Alt+drag pan · Z fit · M mask on/off · O mask overlay · Ctrl+Z/Ctrl+Y undo/redo · Ctrl+S save · Ctrl+R reopen · E export 4K PNG · F frame benchmark · F5 rebuild scene" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
