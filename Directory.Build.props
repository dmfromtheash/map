<Project>
  <PropertyGroup>
    <!-- Map is used only on the owner's current Windows x64 PC. -->
    <VersionPrefix>0.4.0</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <InformationalVersion>$(VersionPrefix)</InformationalVersion>
    <RepositoryType>git</RepositoryType>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Анализаторы из .NET SDK (без пакетов): рекомендуемые правила качества и скорости
         (CA18xx — аллокации, LINQ в горячих путях) как предупреждения, не ошибки. DEC-050. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisModeDocumentation>None</AnalysisModeDocumentation>
    <AnalysisModeNaming>None</AnalysisModeNaming>
  </PropertyGroup>
  <!-- Анализаторы-пакеты (DEC-073): только при сборке, в программу не попадают; правила — предупреждения.
       IDisposableAnalyzers — Skia-объекты после уничтожения / без уничтожения;
       VS Threading — забытый await, блокировки на async, фоновые задачи. -->
  <ItemGroup>
    <PackageReference Include="IDisposableAnalyzers" Version="4.0.8" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>
</Project>
