<Project>
  <PropertyGroup>
    <!-- Map is used only on the owner's current Windows x64 PC. -->
    <VersionPrefix>0.2.0</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>$(VersionPrefix)</InformationalVersion>
    <RepositoryType>git</RepositoryType>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Анализаторы из .NET SDK (без пакетов): рекомендуемые правила качества и скорости
         (CA18xx — аллокации, LINQ в горячих путях) как предупреждения, не ошибки. DEC-050. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisModeDocumentation>None</AnalysisModeDocumentation>
    <AnalysisModeNaming>None</AnalysisModeNaming>
  </PropertyGroup>
</Project>
